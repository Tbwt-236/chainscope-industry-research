# Optional; export variables before starting uvicorn. .env is not loaded implicitly.
DATABASE_URL=sqlite:///runtime/research.db
# Empty disables writes. Configure a long random token for a local reviewer.
ADMIN_TOKEN=
# Optional caller-owned HTTPS normalized-data bridge, not an invented iFinD API.
DATA_PROVIDER=reviewed_historical
DATA_BRIDGE_URL=
DATA_BRIDGE_TOKEN=
# Optional compatible Chat Completions endpoint. No model is called by default.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
